<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- TextSearchStore is experimental in Semantic Kernel. -->
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0130</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ChromaDotNet.VectorData" Version="0.1.2" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <PackageReference Include="Microsoft.SemanticKernel.PromptTemplates.Handlebars" Version="1.80.1" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
  </ItemGroup>

</Project>
